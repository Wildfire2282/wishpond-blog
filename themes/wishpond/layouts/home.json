{{- $pages := (where site.RegularPages "Section" "posts").ByDate.Reverse -}}
[
{{- range $index, $page := $pages -}}
  {{- if $index }},{{ end }}
  {
    "title": {{ $page.Title | jsonify }},
    "url": {{ $page.RelPermalink | jsonify }},
    "description": {{ ($page.Description | default $page.Summary | plainify) | jsonify }},
    "content": {{ ($page.Plain | truncate 1200) | jsonify }},
    "date": {{ $page.Date.Format "2006.01.02" | jsonify }},
    "dateISO": {{ $page.Date.Format "2006-01-02" | jsonify }},
    "topics": {{ $page.Params.topics | jsonify }},
    "tags": {{ $page.Params.tags | jsonify }}
  }
{{- end -}}
]
